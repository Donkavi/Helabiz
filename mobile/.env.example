# Where the Helabiz web app is running. The app calls its /api/mobile routes.
#
# Production: your Vercel domain, e.g. https://helabiz.lk
# Development: your computer's LAN address, not localhost — the phone is a
# different machine. Find it with `ipconfig` and run `npm run dev` there:
#   EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"
EXPO_PUBLIC_API_URL="https://helabiz.lk"
