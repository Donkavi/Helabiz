# MongoDB connection string (Atlas or local).
# Leave blank in development and Helabiz starts an embedded MongoDB for you,
# storing its data in .helabiz-data so your demo data survives restarts.
MONGODB_URI=""
MONGODB_DB="helabiz"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Public base URL and the root domain used for website subdomains
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DOMAIN="helabiz.lk"

# Optional: AI website generator. Leave blank to use the built-in mock generator.
ANTHROPIC_API_KEY=""

# Launch gate. With COMING_SOON="true" every public request is served the
# teaser at /coming-soon instead of the product.
#
# COMING_SOON_BYPASS is the way back in while the gate is up: open any page
# with ?preview=<that value> once and this browser is exempt for 30 days.
# Leave it blank and nobody, including you, can reach the site.
COMING_SOON="true"
COMING_SOON_BYPASS="true"

# Optional: shown on the coming-soon page. Left blank, the links are omitted.
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
