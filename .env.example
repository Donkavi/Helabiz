# MongoDB connection string (Atlas or local).
# Leave blank in development and Helabiz starts an embedded MongoDB for you,
# storing its data in .helabiz-data so your demo data survives restarts.
MONGODB_URI=""
MONGODB_DB="helabiz"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Optional: "Continue with Google". Leave blank and the button is hidden and
# email + password is the only way in.
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type "Web application"). Add one authorised redirect URI per origin:
#   http://localhost:3000/api/auth/callback/google
#   https://helabiz.lk/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public base URL and the root domain used for website subdomains
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DOMAIN="helabiz.lk"

# Optional: AI website generator. Leave blank to use the built-in mock generator.
ANTHROPIC_API_KEY=""

# Cloudinary. Set all three and uploaded images and deposit slips go there;
# leave them blank and the local public/uploads adapter is used instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# The bank account subscribers deposit into, shown on the checkout screen
# beside the slip upload. Leave blank and bank transfer is hidden.
BANK_NAME=""
BANK_BRANCH=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""

# Platform administrators, comma separated. Solves the first-admin problem;
# promote accounts on /admin/users so access stops depending on this.
SUPER_ADMIN_EMAILS=""

# Outgoing email, used by the "Email order updates" website add-on.
# Any SMTP mailbox works. Leave SMTP_HOST or MAIL_FROM blank and nothing is
# sent — what would have gone out is written to the server log instead, and
# orders are never blocked by a mail problem.
#
# Port 465 is implicit TLS; 587 upgrades with STARTTLS. SMTP_SECURE forces it.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Helabiz <orders@helabiz.lk>"

# Optional: give every shop its own sender address. With "mail.helabiz.lk",
# Kavi Fashion's order emails come from "Kavi Fashion <kavi-fashion@mail.helabiz.lk>"
# and replies go to the shop's business email. Leave blank to send everything
# from MAIL_FROM.
#
# The SMTP provider must have this exact domain verified (SPF + DKIM), or the
# mail is rejected or lands in spam. The first label ("mail") is reserved and
# can never be a shop's address.
MAIL_SHOP_DOMAIN=""

# Launch gate. With COMING_SOON="true" every public request is served the
# teaser at /coming-soon instead of the product.
#
# COMING_SOON_BYPASS is the way back in while the gate is up: open any page
# with ?preview=<that value> once and this browser is exempt for 30 days.
# Leave it blank and nobody, including you, can reach the site.
COMING_SOON="true"
COMING_SOON_BYPASS="true"

# Optional: shown on the coming-soon page. Left blank, the links are omitted.
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# Platform administration. Anyone whose email is listed here reaches /admin even
# without the stored role — it exists so the very first admin can be created
# without editing the database. Promote the account on the Users screen, then
# you can empty this. Comma-separated.
SUPER_ADMIN_EMAILS=""
